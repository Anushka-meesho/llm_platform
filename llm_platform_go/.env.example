# ── Provider keys ────────────────────────────────────────────────────────────
# At least ONE of the two must be set, or the server refuses to boot.
#
#   MEESHO_GATEWAY_VK — virtual key for the Meesho bifrost gateway. This single
#                       gateway serves every non-Groq model (GPT-4o, Gemini 2.5,
#                       Claude) over an OpenAI-compatible wire, authenticated with
#                       the x-bf-vk header. Set this to use those models.
#   GROQ_API_KEY      — Groq's own API key. Only needed for the `llama-groq` model,
#                       which is the one model called directly (not via the gateway).
MEESHO_GATEWAY_VK=
GROQ_API_KEY=

# Provider base URLs — override only for a proxy / self-hosted endpoint.
# MEESHO_GATEWAY_BASE_URL=http://llm-gateway.prd.meesho.int/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Server ───────────────────────────────────────────────────────────────────
# PORT=8000
# DB_PATH=./llm_platform.db
# PRICING_PATH=./pricing.json

# ── Auth (set a real JWT_SECRET outside dev) ───────────────────────────────────
JWT_SECRET=dev-insecure-secret-change-me
# AUTH_COOKIE_NAME=llm_platform_token
# AUTH_ISSUER=llm-platform-demo
# COOKIE_DOMAIN=
# COOKIE_SECURE=false
# TOKEN_EXPIRY=12h

# ── Prediction cache (redis if REDIS_ADDR set, else memory, else off) ──────────
# CACHE_BACKEND=memory
# REDIS_ADDR=
# REDIS_PASSWORD=
# REDIS_DB=0

# ── Per-(task, model) health breaker ───────────────────────────────────────────
# HEALTH_BREAKER_ENABLED=true
# HEALTH_FAILURE_THRESHOLD=3
# HEALTH_BASE_COOLDOWN=30s
# HEALTH_MAX_COOLDOWN=30m
